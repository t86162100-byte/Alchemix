# Optional: add a Reown AppKit project ID when enabling WalletConnect.
VITE_REOWN_PROJECT_ID=

# Required for reliable Solana Mainnet access in production.
# Use your dedicated RPC provider's HTTPS endpoint; do not commit private API keys here.
VITE_SOLANA_RPC_URL=

# Optional: dedicated Tron API endpoint (defaults to TronGrid mainnet API).
# Do not put an API key in a VITE_ variable unless you accept it being public in the browser bundle.
VITE_TRON_API_URL=https://api.trongrid.io

# Optional: Bitcoin mainnet API endpoint (defaults to mempool.space).
VITE_BITCOIN_API_URL=https://mempool.space/api

# Optional: TON mainnet API endpoint (defaults to TON API).
VITE_TON_API_URL=https://tonapi.io/v2

# Optional: Stellar Horizon API (defaults to public Stellar mainnet Horizon).
VITE_STELLAR_HORIZON_URL=https://horizon.stellar.org
